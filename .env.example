# Required: Service Principal + dwh_report
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_SQL_ENDPOINT=your-endpoint.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=dwh_report

# Optional metadata only
FABRIC_WORKSPACE_ID=
FABRIC_WAREHOUSE_ID=

# Optional: required only for report=mvd. If endpoint is the same as dwh_report,
# omit FABRIC_TRANSFORM_SQL_ENDPOINT and only set the database.
FABRIC_TRANSFORM_SQL_ENDPOINT=
FABRIC_TRANSFORM_DATABASE=lh_transform

# Ad-hoc SQL defense-in-depth allowlist. Curated dsn_query workflows are not
# restricted by this because their SQL is server-owned.
FABRIC_ADHOC_ALLOWED_SCHEMAS=datamart

# Local output/cache settings
FABRIC_EXPORT_DIR=
FABRIC_RESULT_CACHE_DIR=
FABRIC_RESULT_CACHE_TTL_HOURS=24

# Query/runtime controls
FABRIC_CONNECTION_TIMEOUT_SECONDS=30
FABRIC_QUERY_TIMEOUT_SECONDS=180
FABRIC_FETCH_SIZE=1000
FABRIC_MAX_RESULT_ROWS=250000
FABRIC_MAX_ADHOC_ROWS=2000
FABRIC_DEFAULT_PREVIEW_ROWS=100
FABRIC_MAX_PREVIEW_ROWS=500
